{
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:8080",
    "AuthenticationOptions": {
      "AuthenticationProviderKeys": ["Bearer"]
    }
  },
  "Routes": [
    {
      "UpstreamPathTemplate": "/gateway/register",
      "UpstreamHttpMethod": [ "POST" ],
      "DownstreamPathTemplate": "/api/auth",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "userservice",
          "Port": 8080
        }
      ],
      "AuthenticationOptions": {
        "AllowAnonymous": true
      }
    },
    {
      "UpstreamPathTemplate": "/gateway/profile",
      "UpstreamHttpMethod": [ "GET" ],
      "DownstreamPathTemplate": "/api/auth/profile",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "userservice",
          "Port": 8080
        }
      ],
      "AddHeadersToRequest": {
        "UserId": "Claims[UserId] > value[0] > |"
      }
    },

    // product catalog routing
    {
      "UpstreamPathTemplate": "/gateway/productcatalog",
      "UpstreamHttpMethod": [ "GET" ],
      "DownstreamPathTemplate": "/api/product",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "productcatalog",
          "Port": 8080
        }
      ],
      "AuthenticationOptions": {
        "AllowAnonymous": true
      }
    },

    {
      "UpstreamPathTemplate": "/gateway/productcatalog/{id}",
      "UpstreamHttpMethod": [ "GET" ],
      "DownstreamPathTemplate": "/api/product/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "productcatalog",
          "Port": 8080
        }
      ],
      "AuthenticationOptions": {
        "AllowAnonymous": true
      }
    },

    {
      "UpstreamPathTemplate": "/gateway/productcatalog/{id}",
      "UpstreamHttpMethod": [ "POST", "PUT", "DELETE" ],
      "DownstreamPathTemplate": "/api/product/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "productcatalog",
          "Port": 8080
        }
      ],
      "AddHeadersToRequest": {
        "UserId": "Claims[UserId] > value[0] > |"
      }
    }

  ]
}
