{
  "ConnectionStrings": {
    "DefaultConnection": "Host=postgres-order;Port=5432;Database=ordersdb;Username=postgres;Password=123456",
    "Development": "Host=localhost;Port=5433;Database=ordersdb;Username=postgres;Password=123456"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore.Mvc": "Warning",
        "Microsoft.AspNetCore.Routing": "Warning",
        "Microsoft.AspNetCore.Hosting": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "./logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },

  "AllowedHosts": "*"
}
